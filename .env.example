DISCORD_TOKEN=your_bot_token
# Published image; use a version tag or digest to pin a deployment.
SOUNDCRATE_IMAGE=ghcr.io/ak4duy/soundcrate:latest
# Absolute path on the HOST; mounted read-only at /music inside the container.
MUSIC_FOLDER=/absolute/path/to/music
# Optional: register commands instantly to one server during development.
# Leave empty to register globally.
GUILD_ID=
IDLE_TIMEOUT_SECONDS=300
RUST_LOG=soundcrate=info,songbird=warn,serenity=warn
